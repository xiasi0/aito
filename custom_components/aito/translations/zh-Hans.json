{
  "config": {
    "step": {
      "user": {
        "title": "AITO 登录",
        "description": "请使用已在 AITO App 中获得车辆服务权限的华为账号。首次添加需接收并输入短信验证码。\n\n为支持后续自动续期，集成会在本地加密保存账号密码和固定设备身份。\n\n建议使用专用于 Home Assistant 的账号；在 AITO App 或其他设备登录同一账号，可能导致集成需要重新认证。",
        "data": {
          "phone": "华为账号手机号",
          "password": "华为账号密码"
        }
      },
      "sms": {
        "title": "短信验证",
        "description": "请输入华为发送到该账号手机号的短信验证码。验证码仅用于本次首次登录验证。",
        "data": {
          "sms_code": "短信验证码"
        }
      }
    },
    "error": {
      "cannot_connect": "无法连接 AITO 服务，请稍后重试。",

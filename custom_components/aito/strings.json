        "title": "AITO Login",
        "description": "Use a Huawei account with AITO vehicle service access. The first setup requires an SMS verification code. The integration encrypts and stores the account password and a stable device identity locally to maintain the session. A dedicated Home Assistant account is recommended because signing in to the AITO app or another device with the same account may require the integration to authenticate again.",
        "data": {
          "phone": "Huawei account phone number",
          "password": "Huawei account password"
        }
      },
      "sms": {
        "title": "SMS Verification",
        "description": "Enter the SMS verification code sent to this Huawei account phone number. The code is used only to verify this first sign-in.",
        "data": {
          "sms_code": "SMS verification code"
        }
      }
    },
